# ClearImage environment variables
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Phase 0 (project foundation) does not read any of these yet. They are
# defined now so the structure exists before upload/cleanup logic lands.

# Approved upload limit, in megabytes. Enforced when upload is implemented.
NEXT_PUBLIC_MAX_UPLOAD_MB=25

# Directory used for temporary, privacy-conscious image processing.
# Files written here must be deleted automatically once a session ends.
UPLOAD_TMP_DIR=.tmp/uploads
