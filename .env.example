# ClearImage environment variables
# Copy this file to .env.local for local development:
#   cp .env.example .env.local

# Approved upload limit, in megabytes. Read by src/lib/upload/constants.ts
# and enforced in src/lib/upload/validate-image.ts.
NEXT_PUBLIC_MAX_UPLOAD_MB=25

# Reserved, not yet read anywhere. Upload/Inspect/Cleanup/Export are all
# browser-only today — every image lives only in in-memory object URLs
# (see src/lib/upload/temp-image-store.ts and
# src/lib/cleanup/cleanup-result-store.ts), nothing is written to server
# disk. This variable is a placeholder for a future server-side storage
# phase, not something the current app uses.
UPLOAD_TMP_DIR=.tmp/uploads

# ---------------------------------------------------------------------
# Cloud cleanup (authorized content-aware watermark/text/logo removal)
# ---------------------------------------------------------------------
# This is a real, tested architecture (src/lib/cleanup/cloud/, the
# POST /api/cleanup/process route) sitting behind a provider that is
# currently a placeholder (NullCloudCleanupProvider) — no GPU/quality
# benchmark has been approved yet (see the Phase 8 research notes). Every
# variable below is read only server-side.

# Server-side master switch. When not exactly "true", the API route
# refuses every request with PROVIDER_UNAVAILABLE before it ever reaches a
# provider — no cloud request is possible while this is unset. The Cleanup
# UI's catalog (src/lib/cleanup/operations.ts) does not read this or any
# other env var: every cloud operation is hardcoded "coming soon" until a
# specific provider is approved, as a deliberate, reviewed code change —
# this flag is a server-side kill switch, not a UI toggle.
CLOUD_CLEANUP_ENABLED=false

# Selects which CloudCleanupProvider implementation the server builds (see
# src/lib/cleanup/cloud/provider-registry.ts). "none" (the default) and
# any unrecognized value both resolve to the Null placeholder provider —
# there is currently no real vendor case to select.
CLOUD_CLEANUP_PROVIDER=none

# Real vendor endpoint/credential, once a provider is added. Never commit
# a real value here or in .env.local — this file only documents the shape.
CLOUD_CLEANUP_PROVIDER_ENDPOINT=
CLOUD_CLEANUP_PROVIDER_API_KEY=

# How long the server waits for a provider before returning TIMEOUT.
CLOUD_CLEANUP_TIMEOUT_MS=30000

# Hard cap on a single cloud cleanup request's image size, independent of
# NEXT_PUBLIC_MAX_UPLOAD_MB (the general browser upload limit). Kept much
# smaller than the upload limit on purpose — see
# src/lib/cleanup/cloud/README.md for why a cloud request payload should
# never assume it can carry a full-size upload through a serverless
# request body.
CLOUD_CLEANUP_MAX_REQUEST_MB=8
